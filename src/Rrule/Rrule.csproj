<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Rrule.Net</PackageId>
    <Version>1.0.0</Version>
    <Authors>Israel Iyonsi</Authors>
    <Description>Focused, zero-dependency RFC 5545 RRULE expander. Turns a recurrence rule string plus a start date into occurrence dates for billing cycles, dunning schedules, subscription renewals and reminders, without pulling in a full iCalendar stack. Deterministic, lazy, offline, with RFC 5545 worked-example test vectors.</Description>
    <PackageTags>rrule;rfc5545;recurrence;ical;icalendar;scheduling;cron;billing;subscription;dunning;occurrences;recurring;fintech</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/IsraelIyonsi/Rrule.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <RootNamespace>Rrule</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
